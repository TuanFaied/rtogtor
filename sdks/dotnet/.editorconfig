root = false

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Generated model classes document what the schemas document.
[src/RtoGtoR/Generated/*.cs]
generated_code = true
dotnet_diagnostic.CS1591.severity = none

[tests/**.cs]
dotnet_diagnostic.CS1591.severity = none
# Test method names use underscores for readability.
dotnet_diagnostic.CA1707.severity = none
